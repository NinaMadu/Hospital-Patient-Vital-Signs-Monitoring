        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Alert consumer lag",
      "description": "Alerts in Kafka not yet stored in Postgres.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"ward-alert-consumer\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
