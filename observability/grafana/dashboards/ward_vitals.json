      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(ward_alerts_stored_total{severity=\"CRITICAL\"}[15m])) or vector(0)",
