# Copy to .env before the first run:   cp .env.example .env
# .env is git-ignored. These are local development credentials only.

COMPOSE_PROJECT_NAME=ward-vitals

# ---- Simulated clock (see docs/decisions) --------------------------------
# 1 simulated day = SIM_DAY_SECONDS real seconds.
SIM_DAY_SECONDS=300
# Reference instant for sim_day = floor((ts - SIM_EPOCH) / SIM_DAY_SECONDS).
SIM_EPOCH=2026-09-28T00:00:00+00:00

# ---- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:9094
VITALS_TOPIC=patient-vitals
VITALS_PARTITIONS=3
DLQ_TOPIC=vitals-dlq
DLQ_PARTITIONS=1
ALERTS_TOPIC=patient-alerts
ALERTS_PARTITIONS=3

# ---- PostgreSQL (serving store) ------------------------------------------
POSTGRES_USER=ward
POSTGRES_PASSWORD=ward_dev_pw
POSTGRES_DB=ward
POSTGRES_HOST_PORT=5432
# Address as seen from inside the Docker network (read by common/config.py).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Airflow -------------------------------------------------------------
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_pw
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-local-dev-only

# ---- Spark standalone cluster --------------------------------------------
# The streaming app and a batch job must fit at the same time:
# each app is capped at spark.cores.max=2 (spark/conf/spark-defaults.conf).
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2g

# ---- Grafana (monitoring profile) ----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
